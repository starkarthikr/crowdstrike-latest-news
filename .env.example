# CrowdStrike Monitor Configuration
# Copy this file to .env and update with your values
# NEVER commit the actual .env file!

# GitHub Configuration (for issue creation)
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_REPO=starkarthikr/crowdstrike-monitor

# Monitoring Configuration
MONITOR_INTERVAL_HOURS=24
ENABLE_NOTIFICATIONS=true

# CrowdStrike URLs (usually no need to change)
CROWDSTRIKE_BLOG_URL=https://www.crowdstrike.com/blog/
CROWDSTRIKE_NEWS_URL=https://www.crowdstrike.com/press-releases/
CROWDSTRIKE_SECURITY_ADVISORIES=https://www.crowdstrike.com/resources/

# Notification Settings (optional)
SLACK_WEBHOOK_URL=
EMAIL_RECIPIENT=

# Logging
LOG_LEVEL=INFO
LOG_FILE=crowdstrike_monitor.log

# User Agent (for web scraping)
USER_AGENT=CrowdStrike-Monitor-Bot/1.0

# Rate Limiting
REQUEST_DELAY_SECONDS=2
MAX_RETRIES=3
